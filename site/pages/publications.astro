---
import Base from '../layouts/Base.astro';
import AbstractCard from '../components/AbstractCard.vue';
import CitationHistoryChart from '../components/CitationHistoryChart.vue';
import CitationsPerYearChart from '../components/CitationsPerYearChart.vue';
import PosterCard from '../components/PosterCard.vue';
import PresentationCard from '../components/PresentationCard.vue';
import PublicationRow from '../components/PublicationRow.vue';
import ScholarStats from '../components/ScholarStats.astro';
import TagFilter from '../components/TagFilter.vue';
import { getAbstracts, getPeopleMap, getPosters, getPresentations, getPublications, getTags } from '../lib/data';
import { loadScholar } from '../lib/scholar';
import { historyRows, perYearRows } from '../lib/scholarRows';
import { asset } from '../lib/url';
import { groupByYear, toTagFilterEntries } from '../lib/views';

const [tagInfo, peopleMap, publications, presentations, posters, abstracts] = await Promise.all([getTags(), getPeopleMap(), getPublications(), getPresentations(), getPosters(), getAbstracts()]);
const pdfBase = asset('pdf/');
const avatarBase = asset('image/people/128/');
// rows are static HTML; TagFilter hides the non-matching ones (and any
// year group left empty) client-side, so nothing is serialised twice
const years = groupByYear(publications);
const tagFilterEntries = toTagFilterEntries(tagInfo);

// Live Google Scholar data (see CLAUDE.md, "Live GitHub and Scholar data"):
// read the daily snapshot once here and server-render the summary strip and
// both chart rows from it; the strip updater and the two islands refetch it in
// the browser, so the numbers keep up with the data branch without a redeploy.
// A failed read yields an empty snapshot and the strip renders without values.
const scholar = await loadScholar();
const perYear = perYearRows(scholar);
const history = historyRows(scholar);
// the site's own count, not a Scholar number: peer-reviewed entries of
// data/publications.yml (theses, reports, preprints and abstracts excluded)
const PEER_REVIEWED = new Set(['publication', 'review', 'proceeding', 'chapter']);
const publicationCount = publications.filter((p) => PEER_REVIEWED.has(p.status)).length;
---
<Base title="Publications" sectionid="publications">
  <section id="scholar">
    <h2>Citations</h2>
    <ScholarStats scholar={scholar} publications={publicationCount} />
    <div class="scholar-charts">
      <CitationsPerYearChart client:visible rows={perYear} fetchedAt={scholar.fetchedAt} />
      <CitationHistoryChart client:visible rows={history} fetchedAt={scholar.fetchedAt} />
    </div>
  </section>

  <h2 id="publications">Publications</h2>
  <TagFilter client:idle id="publication" tags={tagFilterEntries} target="publication-list" />
  <div id="publication-list">
    {years.map((g) => (
      <div class="pub-year-group">
        <h3 class="year-heading">{g.year}</h3>
        <table class="table publication-table">
          <colgroup><col class="publication-status-col" /><col /></colgroup>
          <tbody>
            {g.items.map((p) => <PublicationRow pub={p} tagInfo={tagInfo} peopleMap={peopleMap} pdfBase={pdfBase} avatarBase={avatarBase} />)}
          </tbody>
        </table>
      </div>
    ))}
  </div>

  <h2 id="presentations">Presentations</h2>
  <div class="project-grid" id="presentations-grid">
    {presentations.map((p) => <PresentationCard item={p} tagInfo={tagInfo} peopleMap={peopleMap} pdfBase={pdfBase} avatarBase={avatarBase} />)}
  </div>

  <h2 id="posters">Posters</h2>
  <div class="project-grid" id="posters-grid">
    {posters.map((p) => <PosterCard item={p} tagInfo={tagInfo} peopleMap={peopleMap} pdfBase={pdfBase} avatarBase={avatarBase} />)}
  </div>

  <h2 id="abstracts">Abstracts</h2>
  <div class="project-grid" id="abstracts-grid">
    {abstracts.map((a) => <AbstractCard item={a} pdfBase={pdfBase} />)}
  </div>
</Base>
