---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.vue';
import TagFilter from '../components/TagFilter.vue';
import { getPeopleMap, getProjects, getPublications, getTags } from '../lib/data';
import { asset } from '../lib/url';
import { toTagFilterEntries } from '../lib/views';

const [tagInfo, peopleMap, projects, publications] = await Promise.all([getTags(), getPeopleMap(), getProjects(), getPublications()]);
const current = projects.filter((p) => p.status === 'current');
const imageBase = asset('image/projects/');
const pdfBase = asset('pdf/');
const avatarBase = asset('image/people/128/');
const tagFilterEntries = toTagFilterEntries(tagInfo);
---
<Base title="Projects" sectionid="projects">
  <TagFilter client:idle id="project" tags={tagFilterEntries} target="project-grid" />
  <div class="project-grid" id="project-grid">
    {current.map((p) => <ProjectCard project={p} tagInfo={tagInfo} peopleMap={peopleMap} publications={publications} imageBase={imageBase} pdfBase={pdfBase} avatarBase={avatarBase} />)}
  </div>
</Base>
