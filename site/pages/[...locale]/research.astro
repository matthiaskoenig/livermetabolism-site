---
import Base from '../../layouts/Base.astro';
import CommitActivityChart from '../../components/CommitActivityChart.vue';
import EditorCard from '../../components/EditorCard.vue';
import FundingCard from '../../components/FundingCard.vue';
import ReleaseFeed from '../../components/ReleaseFeed.vue';
import ReleaseTimeline from '../../components/ReleaseTimeline.vue';
import SoftwareCard from '../../components/SoftwareCard.vue';
import SoftwareLive from '../../components/SoftwareLive.astro';
import StarsChart from '../../components/StarsChart.vue';
import TagFilter from '../../components/TagFilter.vue';
import { repoFullName } from '../../../scripts/lib/repos';
import { getEditors, getFunding, getPeopleMap, getSoftware, getTags } from '../../lib/data';
import { loadSnapshot } from '../../lib/github';
import { activityRows, latestReleases, releaseTimelineRows, starsRows, statsFor } from '../../lib/githubRows';
import { uiFor } from '../../lib/i18n/catalog';
import { localeFromParams, localePaths } from '../../lib/i18n/routes';
import { slices } from '../../lib/i18n/slices';
import { asset } from '../../lib/url';
import { toTagFilterEntries } from '../../lib/views';

export const getStaticPaths = localePaths;
const locale = localeFromParams(Astro.params);
const { t } = uiFor(locale);
const ui = slices(t);
const [tagInfo, peopleMap, software, funding, editors] = await Promise.all([getTags(), getPeopleMap(), getSoftware(), getFunding(), getEditors()]);
const avatarBase = asset('image/people/128/');
const tagFilterEntries = toTagFilterEntries(tagInfo);
// three independent TagFilter islands; each reads the same ?tag= on mount,
// so a /research/?tag=AI link still pre-filters all three grids

// Live GitHub data (see CLAUDE.md, "Live GitHub data"): read the daily
// snapshot once here and server-render the stats lines, the release feed and
// the chart rows from it. The islands below refetch it in the browser, so the
// page keeps up with the data branch without a redeploy; a failed read yields
// an empty snapshot and the GitHub parts simply render empty.
const snapshot = await loadSnapshot();
const repos = [...new Set(software.map((s) => (s.repository ? repoFullName(s.repository) : null)).filter((r): r is string => r !== null))];
const releaseRows = latestReleases(snapshot, repos);
const timelineRows = releaseTimelineRows(snapshot, repos);
const stars = starsRows(snapshot, repos);
const activity = activityRows(snapshot, repos);
---
<Base title={t('nav.research')} sectionid="research" locale={locale}>
  <section id="releases">
    <h2>{t('nav.releases')}</h2>
    <h3>{t('research.latestReleases')}</h3>
    <ReleaseFeed client:visible rows={releaseRows} repos={repos} fetchedAt={snapshot.fetchedAt} strings={ui.releaseFeed} />
    <h3>{t('research.releaseHistory')}</h3>
    <ReleaseTimeline client:visible rows={timelineRows} repos={repos} fetchedAt={snapshot.fetchedAt} strings={ui.releaseTimeline} />
  </section>

  <section id="activity">
    <h2>{t('nav.activity')}</h2>
    <h3>{t('research.commitActivity')}</h3>
    <CommitActivityChart client:visible data={activity} repos={repos} fetchedAt={snapshot.fetchedAt} strings={ui.commitActivityChart} />
    <h3>{t('gh.stars')}</h3>
    <StarsChart client:visible rows={stars} repos={repos} fetchedAt={snapshot.fetchedAt} strings={ui.starsChart} />
  </section>

  <h2 id="software">{t('nav.software')}</h2>
  <TagFilter client:idle id="software" tags={tagFilterEntries} target="software-grid" strings={ui.tagFilter} />
  <div class="project-grid" id="software-grid">
    {software.map((item) => {
      // the snapshot key, which is also the card's data-repo: the browser-side
      // refresh looks the repository up by it again (see statsFor)
      const repo = item.repository ? repoFullName(item.repository) : null;
      return (
        <SoftwareCard
          item={item}
          tagInfo={tagInfo}
          peopleMap={peopleMap}
          imageBase={asset('image/software/')}
          avatarBase={avatarBase}
          repo={repo}
          stats={repo ? statsFor(snapshot, repo) : null}
          strings={ui.softwareCard}
        />
      );
    })}
  </div>
  <SoftwareLive fetchedAt={snapshot.fetchedAt} locale={locale} />

  <h2 id="funding">{t('nav.funding')}</h2>
  <TagFilter client:idle id="funding" tags={tagFilterEntries} target="funding-grid" strings={ui.tagFilter} />
  <div class="project-grid" id="funding-grid">
    {funding.map((item) => <FundingCard item={item} tagInfo={tagInfo} imageBase={asset('image/funding/')} strings={ui.links} />)}
  </div>
  <p>
    {t('research.fundingBefore')} <a href="https://www.denbi.de/">{t('research.fundingLinkText')}</a> {t('research.fundingAfter')}
  </p>

  <h2 id="editors">{t('nav.editors')}</h2>
  <p>{t('research.editorsIntro')}</p>
  <TagFilter client:idle id="editors" tags={tagFilterEntries} target="editors-grid" strings={ui.tagFilter} />
  <div class="project-grid" id="editors-grid">
    {editors.map((item) => <EditorCard item={item} tagInfo={tagInfo} imageBase={asset('image/editors/')} strings={ui.links} />)}
  </div>
</Base>
