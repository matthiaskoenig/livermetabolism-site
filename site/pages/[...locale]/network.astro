---
import { publicDir } from 'astro:config/server';
import { readdirSync } from 'node:fs';
import { relative, sep } from 'node:path';
import { fileURLToPath } from 'node:url';
import Base from '../../layouts/Base.astro';
import NetworkGraph from '../../components/NetworkGraph.vue';
import { loadCitations } from '../../lib/citations';
import { getPeople, getProjects, getPublications, getSoftware, getTags } from '../../lib/data';
import { graphRows } from '../../lib/graphRows';
import { localeFromParams, localePaths, localeUrl } from '../../lib/i18n/routes';
import { filterRows } from '../../lib/networkOptions';

export const getStaticPaths = localePaths;
const locale = localeFromParams(Astro.params);
const [tags, people, publications, projects, software] = await Promise.all([getTags(), getPeople(), getPublications(), getProjects(), getSoftware()]);
// citations size the publication nodes; a failed read yields an empty
// snapshot and every paper draws at its minimum size
const citations = await loadCitations();

// The thumbnails that actually exist (npm run graph:thumbs writes them, see
// CLAUDE.md); a node without one falls back to a plain circle. `publicDir`
// comes from the build's own config — `import.meta.url` would point into the
// bundled prerender chunk under dist/, and the working directory is not ours
// to rely on either.
const thumbRoot = fileURLToPath(new URL('assets/image/graph', publicDir));
// A missing directory is not fatal: graphRows() draws a circle for a node
// without a thumbnail, so an unreadable directory means circles, not a
// failed build.
let thumbs = new Set<string>();
try {
  thumbs = new Set(
    readdirSync(thumbRoot, { withFileTypes: true, recursive: true })
      .filter((e) => e.isFile())
      .map((e) => `assets/image/graph/${relative(thumbRoot, `${e.parentPath}${sep}${e.name}`).split(sep).join('/')}`),
  );
} catch (error) {
  console.warn(`[network] no graph thumbnails at ${thumbRoot} (${error}); nodes fall back to circles`);
}

// Rows and hrefs are built once here; the island only draws them and filters
// them by research area (about 100 kB of props for a page whose content is
// the graph).
const rows = graphRows({
  tags, people, publications, projects, software, citations, thumbs,
  base: localeUrl(locale, '/'), assetBase: import.meta.env.BASE_URL,
});
const topics = tags.map(({ tag, slug }) => ({ tag, slug }));
// what the graph actually draws: filterRows() drops a node without a single
// link, so the intro counts the connected network rather than the table rows
const shown = filterRows(rows, null);
const counts = {
  people: shown.nodes.filter((n) => n.type === 'person').length,
  publications: shown.nodes.filter((n) => n.type === 'publication').length,
  projects: shown.nodes.filter((n) => n.type === 'project').length,
  software: shown.nodes.filter((n) => n.type === 'software').length,
};
---
<Base title="Network" sectionid="network" locale={locale}
  description="Interactive network graph of the people, publications, projects, and software of the König group.">
  <h2 id="network">Network</h2>
  <p>
    How the work of the group hangs together: {counts.people} people, {counts.publications} publications,
    {counts.projects} projects and {counts.software} software tools, connected by authorship and membership. People carry
    their photo, projects are squares, software diamonds and publications dots in their research area's colour; every
    node is sized by how many people, papers, projects and tools it connects to.
  </p>
  <p>
    Pick a research area to show only its people, publications, projects and software — the graph re-arranges itself
    around what is left. Drag a node to move it, drag the background to pan, and click a node to open it on the site.
  </p>
  <div id="network-graph">
    <NetworkGraph client:load rows={rows} topics={topics} />
  </div>
</Base>
