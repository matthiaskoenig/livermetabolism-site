---
import Base from '../../layouts/Base.astro';
import AbstractCard from '../../components/AbstractCard.vue';
import CitationHistoryChart from '../../components/CitationHistoryChart.vue';
import CitationsPerYearChart from '../../components/CitationsPerYearChart.vue';
import PosterCard from '../../components/PosterCard.vue';
import PresentationCard from '../../components/PresentationCard.vue';
import PublicationRow from '../../components/PublicationRow.vue';
import PublicationsChart from '../../components/PublicationsChart.vue';
import PublicationsOrder from '../../components/PublicationsOrder.astro';
import ScholarStats from '../../components/ScholarStats.astro';
import { citationFor, loadCitations } from '../../lib/citations';
import { getAbstracts, getPeopleMap, getPosters, getPresentations, getPublications, getTags } from '../../lib/data';
import { countPeerReviewed } from '../../lib/homeStats';
import { uiFor } from '../../lib/i18n/catalog';
import { localeFromParams, localePaths } from '../../lib/i18n/routes';
import { slices } from '../../lib/i18n/slices';
import { publicationsPerYear } from '../../lib/publicationRows';
import { loadScholar } from '../../lib/scholar';
import { historyRows, perYearRows } from '../../lib/scholarRows';
import { asset } from '../../lib/url';
import { groupByYear } from '../../lib/views';

export const getStaticPaths = localePaths;
const locale = localeFromParams(Astro.params);
const { t } = uiFor(locale);
const ui = slices(t);
const [tagInfo, peopleMap, publications, presentations, posters, abstracts] = await Promise.all([getTags(locale), getPeopleMap(locale), getPublications(locale), getPresentations(locale), getPosters(locale), getAbstracts(locale)]);
const pdfBase = asset('pdf/');
const avatarBase = asset('image/people/128/');
// rows are static HTML; the site-wide research-area bar (TopicFilter.astro)
// hides the non-matching ones, and any year group left empty, client-side,
// so nothing is serialised twice.
// Sorted by year descending first: the "Most cited" order of
// PublicationsOrder.astro keeps the rendered order as its tie-break, so the
// rows must not depend on where an entry sits in publications.yml.
const years = groupByYear([...publications].sort((a, b) => b.year - a.year));

// Live Google Scholar data (see CLAUDE.md, "Live GitHub and Scholar data"):
// read the daily snapshot once here and server-render the summary strip and
// both chart rows from it; the strip updater and the two islands refetch it in
// the browser, so the numbers keep up with the data branch without a redeploy.
// A failed read yields an empty snapshot and the strip renders without values.
const scholar = await loadScholar();
const perYear = perYearRows(scholar);
const history = historyRows(scholar);
// Per-paper citation counts (OpenAlex, same daily data branch): the badges are
// server-rendered from this snapshot and patched from the live one by
// PublicationsOrder.astro's script, which also drives the ordering toggle.
const citations = await loadCitations();
// the site's own count, not a Scholar number: peer-reviewed entries of
// data/publications.yml (theses, reports, preprints and abstracts excluded).
// Shared with the homepage strip so the two figures cannot drift apart.
const publicationCount = countPeerReviewed(publications);
// papers per year for the chart island: build-time only (no snapshot, no
// fetch) — the island's props are these aggregates, not the publications
const chartRows = publicationsPerYear(publications, tagInfo);
---
<Base title={t('nav.publications')} sectionid="publications" locale={locale} filter>
  <section id="scholar">
    <h2>{t('scholar.citations')}</h2>
    <ScholarStats scholar={scholar} publications={publicationCount} locale={locale} />
    <div class="scholar-charts">
      <CitationsPerYearChart client:visible rows={perYear} fetchedAt={scholar.fetchedAt} strings={ui.citationsPerYearChart} locale={locale} />
      <CitationHistoryChart client:visible rows={history} fetchedAt={scholar.fetchedAt} strings={ui.citationHistoryChart} locale={locale} />
    </div>
  </section>

  <section id="publications-chart">
    <h2>{t('pubChart.title')}</h2>
    <PublicationsChart client:visible rows={chartRows} strings={ui.publicationsChart} locale={locale} />
    <p class="chart-note">{t('pubChart.note')}</p>
  </section>

  <h2 id="publications">{t('nav.publications')}</h2>
  <PublicationsOrder fetchedAt={citations.fetchedAt} locale={locale} />
  <div id="publication-list">
    {years.map((g) => (
      <div class="pub-year-group" data-filter-group>
        <h3 class="year-heading">{g.year}</h3>
        <table class="table publication-table">
          <colgroup><col class="publication-status-col" /><col /></colgroup>
          <tbody>
            {g.items.map((p) => <PublicationRow pub={p} tagInfo={tagInfo} peopleMap={peopleMap} pdfBase={pdfBase} avatarBase={avatarBase} citation={citationFor(citations, p.doi)} strings={ui.publicationRow} />)}
          </tbody>
        </table>
      </div>
    ))}
    {/* "Most cited" moves the existing rows in here (pubOrder.ts) - one copy of
        the rows, and inside #publication-list so the tag filter still finds
        them by [data-tags] in either order */}
    <table id="publication-list-flat" class="table publication-table" hidden>
      <colgroup><col class="publication-status-col" /><col /></colgroup>
      <tbody></tbody>
    </table>
    <p data-filter-empty hidden>{t('filter.empty')}</p>
  </div>

  <h2 id="presentations">{t('nav.presentations')}</h2>
  <div class="project-grid" id="presentations-grid">
    {presentations.map((p) => <PresentationCard item={p} tagInfo={tagInfo} peopleMap={peopleMap} pdfBase={pdfBase} avatarBase={avatarBase} strings={ui.links} />)}
    <p data-filter-empty hidden>{t('filter.empty')}</p>
  </div>

  <h2 id="posters">{t('nav.posters')}</h2>
  <div class="project-grid" id="posters-grid">
    {posters.map((p) => <PosterCard item={p} tagInfo={tagInfo} peopleMap={peopleMap} pdfBase={pdfBase} avatarBase={avatarBase} strings={ui.links} />)}
    <p data-filter-empty hidden>{t('filter.empty')}</p>
  </div>

  <h2 id="abstracts">{t('nav.abstracts')}</h2>
  <div class="project-grid" id="abstracts-grid">
    {abstracts.map((a) => <AbstractCard item={a} tagInfo={tagInfo} pdfBase={pdfBase} strings={ui.links} />)}
    <p data-filter-empty hidden>{t('filter.empty')}</p>
  </div>
</Base>
