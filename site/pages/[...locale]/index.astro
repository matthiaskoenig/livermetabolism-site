---
import Base from '../../layouts/Base.astro';
import CoreMessages from '../../components/CoreMessages.astro';
import HomeStats from '../../components/HomeStats.astro';
import Icon from '../../components/Icon.vue';
import PersonAvatar from '../../components/PersonAvatar.vue';
import { getPeople, getProjects, getPublications, getSoftware, getTags } from '../../lib/data';
import { uiFor } from '../../lib/i18n/catalog';
import { fmt } from '../../lib/i18n/format';
import { localeFromParams, localePaths, urlFor } from '../../lib/i18n/routes';
import { slices } from '../../lib/i18n/slices';
import { TAG_GRAPHICS } from '../../lib/tagGraphics';
import { stripHtml, truncateWords } from '../../lib/text';
import { asset } from '../../lib/url';
import { tagCounts } from '../../lib/views';

export const getStaticPaths = localePaths;
const locale = localeFromParams(Astro.params);
const u = urlFor(locale);
const { t } = uiFor(locale);
const ui = slices(t);
const [tags, people, publications, projects, software] = await Promise.all([getTags(), getPeople(), getPublications(), getProjects(), getSoftware()]);
const strip = people.filter((p) => p.status === 'current' && p.image);

const sections = tags.map((tag, i) => {
  const prev = i === 0 ? { slug: 'home', label: t('home.sectionHome') } : { slug: tags[i - 1].slug, label: tags[i - 1].tag };
  const next = i === tags.length - 1 ? { slug: 'footer', label: t('home.sectionFooter') } : { slug: tags[i + 1].slug, label: tags[i + 1].tag };
  return { ...tag, prev, next, counts: tagCounts(tag.tag, publications, projects, software), graphic: TAG_GRAPHICS[tag.slug] };
});
const quickLinks = [
  { href: u('/projects/'), icon: 'cogs', title: t('nav.projects'), text: t('home.linkProjectsText') },
  { href: u('/publications/'), icon: 'file-pdf-o', title: t('nav.publications'), text: t('home.linkPublicationsText') },
  { href: u('/research/#software'), icon: 'code', title: t('nav.software'), text: t('home.linkSoftwareText') },
  { href: u('/people/'), icon: 'user-circle-o', title: t('nav.team'), text: t('home.linkTeamText') },
  { href: u('/people/#open-positions'), icon: 'users', title: t('nav.openPositions'), text: t('home.linkOpenPositionsText') },
];
---
<Base locale={locale}>
  <section class="page-section" id="home">
    <div class="text-justify">
      <h2 class="header-light">{t('footer.tagline')}</h2>
      <p class="hero-subtitle">{t('home.subtitle')}</p>
    </div>

    <HomeStats />

    <CoreMessages tags={tags} />

    <div class="text-center vision-statement">
      <p class="lead">
        {t('home.visionBefore')} <strong>{t('home.visionStrong')}</strong> {t('home.visionAfter')}
      </p>
    </div>

    <div class="text-center">
      <div class="people-strip">
        {strip.map((p) => (
          <PersonAvatar client:visible name={p.name} src={asset(`image/people/128/${p.image}`)} position={p.role[p.role.length - 1] ?? ''}
            description={p.description ? truncateWords(stripHtml(p.description), 24) : null} detail={`person:${p.id}`} strings={{ fullProfile: ui.personCard.fullProfile }} />
        ))}
      </div>
    </div>

    <div class="text-center vision-statement">
      <p class="lead">{t('home.provocation')}</p>
    </div>

    <div class="core-messages">
      {quickLinks.map((q) => (
        <div class="core-message">
          <a href={q.href}><Icon name={q.icon} /><h3>{q.title}</h3><p>{q.text}</p></a>
        </div>
      ))}
    </div>

    <a class="section-scroll-cue section-scroll-cue-down" href={`#${tags[0].slug}`} aria-label={fmt(t('home.scrollTo'), { label: tags[0].tag })}><Icon name="chevron-down" /></a>
  </section>

  {sections.map((s) => (
    <section class:list={['page-section', 'tag-section', `tag-${s.slug}`]} id={s.slug}>
      {s.graphic && <img class="tag-section-graphic" src={asset(`image/tags/${s.graphic}`)} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
      <a class="section-scroll-cue section-scroll-cue-up" href={`#${s.prev.slug}`} aria-label={fmt(t('home.scrollTo'), { label: s.prev.label })}><Icon name="chevron-up" /></a>
      <div class="tag-section-columns">
        <div class="tag-section-content">
          <Icon name={s.icon.replace(/^fa-/, '')} />
          <h2>{s.tag}</h2>
          <p class="lead">{s.vision}</p>
        </div>
        {(s.counts.publications > 0 || s.counts.projects > 0 || s.counts.software > 0) && (
          <div class="tag-section-links">
            {s.counts.publications > 0 && (
              <a class="tag-section-link" href={`${u('/publications/')}?tag=${encodeURIComponent(s.tag)}`}>
                <Icon name="file-pdf-o" /><span><strong>{t('nav.publications')}</strong><span>{fmt(t('home.publicationsOn'), { tag: s.tag })}</span></span>
              </a>
            )}
            {s.counts.projects > 0 && (
              <a class="tag-section-link" href={`${u('/projects/')}?tag=${encodeURIComponent(s.tag)}`}>
                <Icon name="cogs" /><span><strong>{t('nav.projects')}</strong><span>{fmt(t('home.projectsOn'), { tag: s.tag })}</span></span>
              </a>
            )}
            {s.counts.software > 0 && (
              <a class="tag-section-link" href={`${u('/research/')}?tag=${encodeURIComponent(s.tag)}#software`}>
                <Icon name="code" /><span><strong>{t('nav.software')}</strong><span>{fmt(t('home.softwareOn'), { tag: s.tag })}</span></span>
              </a>
            )}
            <a class="tag-section-link" href={`${u('/network/')}?topic=${encodeURIComponent(s.tag)}`}>
              <Icon name="share-alt" /><span><strong>{t('nav.network')}</strong><span>{fmt(t('home.networkOn'), { tag: s.tag })}</span></span>
            </a>
          </div>
        )}
      </div>
      <a class="section-scroll-cue section-scroll-cue-down" href={`#${s.next.slug}`} aria-label={fmt(t('home.scrollTo'), { label: s.next.label })}><Icon name="chevron-down" /></a>
    </section>
  ))}
</Base>
