---
import '../styles/global.css';
import Head from '../components/Head.astro';
import IconSprite from '../components/IconSprite.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import SiteSearch from '../components/SiteSearch.astro';
import CookieConsent from '../components/CookieConsent.astro';
import DetailModal from '../components/DetailModal.astro';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n/locales';
import { localeUrl } from '../lib/i18n/routes';

interface Props { title?: string; description?: string; sectionid?: string; locale?: Locale }
const { title, description, sectionid, locale = DEFAULT_LOCALE } = Astro.props;
const isHome = Astro.url.pathname === localeUrl(locale, '/');
---
<html lang={locale} class:list={[{ onepager: isHome }]}>
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <IconSprite />
    <TopNav sectionid={sectionid} locale={locale} />
    <div class="page-content">
      <div class="wrapper">
        <div class="container">
          <slot />
        </div>
      </div>
    </div>
    <Footer home={isHome} locale={locale} />
    <CookieConsent gaId="G-FDNGDW6G09" privacyUrl={localeUrl(locale, '/privacy/')} />
    <SiteSearch searchUrl={localeUrl(locale, '/search.json')} />
    <DetailModal />
    <slot name="global" />
    <script>
      // The document-level modal router (the detail modal, the search
      // dialog): plain TypeScript, so a page whose only interactive parts
      // are static dialogs ships no Vue runtime at all.
      import { installModalRouter } from '../lib/modals';
      installModalRouter();
    </script>
  </body>
</html>
