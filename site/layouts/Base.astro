---
import '../styles/global.css';
import Head from '../components/Head.astro';
import IconSprite from '../components/IconSprite.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import SiteSearch from '../components/SiteSearch.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { url } from '../lib/url';

interface Props { title?: string; description?: string; sectionid?: string }
const { title, description, sectionid } = Astro.props;
const isHome = Astro.url.pathname === url('/');
---
<html lang="en" class:list={[{ onepager: isHome }]}>
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <IconSprite />
    <TopNav sectionid={sectionid} />
    <div class="page-content">
      <div class="wrapper">
        <div class="container">
          <slot />
        </div>
      </div>
    </div>
    <Footer home={isHome} />
    <CookieConsent gaId="G-FDNGDW6G09" privacyUrl={url('/privacy/')} />
    <SiteSearch searchUrl={url('/search.json')} />
    <slot name="global" />
    <script>
      // The document-level modal router (person/project/news modals, the
      // search dialog): plain TypeScript, so a page whose only interactive
      // parts are static dialogs ships no Vue runtime at all.
      import { installModalRouter } from '../lib/modals';
      installModalRouter();
    </script>
  </body>
</html>
