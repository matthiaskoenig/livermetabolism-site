---
import Icon from './Icon.vue';
import LanguageSwitch from './LanguageSwitch.astro';
import { uiFor } from '../lib/i18n/catalog';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n/locales';
import { urlFor } from '../lib/i18n/routes';
import { asset } from '../lib/url';

interface Props { sectionid?: string; locale?: Locale }
const { sectionid, locale = DEFAULT_LOCALE } = Astro.props;
const u = urlFor(locale);
const { t } = uiFor(locale);
const active = (...ids: string[]) => (sectionid && ids.includes(sectionid) ? 'active' : '');
---
<nav class="navbar site-navbar">
  <div class="container navbar-container">
    <a class="navbar-brand" href={u('/')}>
      <svg class="brand-mark" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <polygon points="50,4 91,27 91,73 50,96 9,73 9,27" fill="none" stroke="#18BC9C" stroke-width="5"></polygon>
        <g stroke="#EAF0F1" stroke-width="3" fill="none">
          <line x1="50" y1="30" x2="30" y2="55"></line>
          <line x1="50" y1="30" x2="70" y2="55"></line>
          <line x1="30" y1="55" x2="50" y2="75"></line>
          <line x1="70" y1="55" x2="50" y2="75"></line>
          <line x1="30" y1="55" x2="70" y2="55"></line>
        </g>
        <circle cx="50" cy="30" r="7" fill="#18BC9C"></circle>
        <circle cx="30" cy="55" r="7" fill="#EAF0F1"></circle>
        <circle cx="70" cy="55" r="7" fill="#EAF0F1"></circle>
        <circle cx="50" cy="75" r="7" fill="#18BC9C"></circle>
      </svg>
      <span class="brand-word">König Lab</span>
    </a>
    <div class="navbar-controls">
      <LanguageSwitch locale={locale} />
      <button type="button" class="search-toggle" data-modal-target="site-search-modal" aria-label={t('search.open')} title={t('search.openTitle', { key: '/' })}>
        <Icon name="search" />
      </button>
      <button type="button" class="navbar-toggler" id="navbar-toggler" aria-controls="navbar" aria-expanded="false" aria-label={t('nav.toggleNav')}>
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
    <div id="navbar" class="navbar-collapse">
      <ul class="navbar-nav">
        <li class:list={['nav-item', 'dropdown', active('publications')]}>
          <a class="nav-link" href={u('/publications/')}>{t('nav.publications')}</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href={u('/publications/#scholar')}>{t('nav.citations')}</a></li>
            <li><a class="dropdown-item" href={u('/publications/#publications')}>{t('nav.publications')}</a></li>
            <li><a class="dropdown-item" href={u('/publications/#presentations')}>{t('nav.presentations')}</a></li>
            <li><a class="dropdown-item" href={u('/publications/#posters')}>{t('nav.posters')}</a></li>
            <li><a class="dropdown-item" href={u('/publications/#abstracts')}>{t('nav.abstracts')}</a></li>
          </ul>
        </li>
        <li class:list={['nav-item', active('projects')]}><a class="nav-link" href={u('/projects/')}>{t('nav.projects')}</a></li>
        <li class:list={['nav-item', 'dropdown', active('people')]}>
          <a class="nav-link" href={u('/people/')}>{t('nav.team')}</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href={u('/people/#current-members')}>{t('nav.team')}</a></li>
            <li><a class="dropdown-item" href={u('/people/#open-positions')}>{t('nav.openPositions')}</a></li>
            <li><a class="dropdown-item" href={u('/people/#alumni')}>{t('nav.alumni')}</a></li>
          </ul>
        </li>
        <li class:list={['nav-item', 'dropdown', active('research', 'meetings')]}>
          <a class="nav-link" href={u('/research/')}>{t('nav.research')}</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href={u('/research/#releases')}>{t('nav.releases')}</a></li>
            <li><a class="dropdown-item" href={u('/research/#activity')}>{t('nav.activity')}</a></li>
            <li><a class="dropdown-item" href={u('/research/#software')}>{t('nav.software')}</a></li>
            <li><a class="dropdown-item" href={u('/research/#funding')}>{t('nav.funding')}</a></li>
            <li><a class="dropdown-item" href={u('/research/#editors')}>{t('nav.editors')}</a></li>
            <li><a class="dropdown-item" href={u('/meetings/')}>{t('nav.meetings')}</a></li>
          </ul>
        </li>
        <li class:list={['nav-item', active('network')]}><a class="nav-link" href={u('/network/')}>{t('nav.network')}</a></li>
        <li class:list={['nav-item', active('news')]}><a class="nav-link" href={u('/news/')}>{t('nav.news')}</a></li>
        <li class:list={['nav-item', active('teaching')]}><a class="nav-link" href={u('/teaching/')}>{t('nav.teaching')}</a></li>
        <li class="nav-item"><a class="nav-link" href={asset('cv/Koenig_CV.pdf')} target="_blank" rel="noopener noreferrer">{t('nav.cv')}</a></li>
      </ul>
    </div>
  </div>
</nav>

<script>
  // Mobile navbar toggle (plain TypeScript, bundled by Astro: no Vue island
  // for site chrome that is on every page).
  const toggler = document.getElementById('navbar-toggler');
  const navbar = document.getElementById('navbar');
  toggler?.addEventListener('click', () => {
    const open = !(toggler.getAttribute('aria-expanded') === 'true');
    toggler.setAttribute('aria-expanded', open ? 'true' : 'false');
    navbar?.classList.toggle('show', open);
  });
</script>
